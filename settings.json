{
  // =========================
  // General
  // =========================
  "session": {
    "trust_all_worktrees": true,
  },
  "cli_default_open_behavior": "existing_window",
  "auto_install_extensions": {
    "html": true,
    "qml": true,
    "tokyo-night": true,
    "toml": true,
    "vscode-icons": true,
    "markdownlint": true,
    // "git-firefly": true,
    // "lua": true,
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.obsidian",
    "**/.stfolder",
    "**/.stversions",
    "**/.svn",
    "**/.hg",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.venv",
    "**/.vscode",
    "**/__pycache__",
    "**/plugins",
    "**/.Rhistory",
    "**/*.RData",
    "**/*.lock",
    "**/*.log",
    "**/*.pdf",
    "**/*.svg",
    // "**/*.png",
    "**/*.jpg",
    "**/*.mp4",
    "**/*.sqlite",
    // "**/*.bak",
    "**/*cache",
    "**/bin",
    "**/catboost_info",
    "**/cron",
    "**/hermes-agent",
    "**/hooks",
    "**/logs",
    "**/memories",
    "**/pairing",
    "**/sandboxes",
    "**/sessions",
    "**/skills",
    "**/whatsapp",
  ],

  // =========================
  // Theme & Icons
  // =========================
  "theme": {
    "mode": "dark",
    "dark": "Tokyo Night Storm",
    "light": "One Light",
  },
  "theme_overrides": {
    "Tokyo Night Storm": {
      "editor.line_number": "#51597d",
      "syntax": {
        "comment": {
          "font_style": "italic",
          "color": "#7e86b9",
        },
        "string.doc": {
          "font_style": "italic",
          "color": "#7e86b9",
          // "color": "#a7cdf3",
          // "color": "#699BC3",
        },
      },
    },
  },
  "icon_theme": {
    "mode": "dark",
    "dark": "VSCode Icons for Zed (Dark Official Icons)",
    "light": "VSCode Icons for Zed (Dark Official Icons)",
  },
  // "full" does not work yet (https://github.com/zed-industries/zed/issues/51430)
  "semantic_tokens": "combined", // off (default) | combined | full

  // =========================
  // Editor
  // =========================
  "base_keymap": "VSCode",

  "buffer_font_fallbacks": ["CaskaydiaCove Nerd Font"],
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "buffer_font_features": { "calt": false }, // ligature off
  "buffer_font_size": 15,
  "buffer_font_weight": 400,

  "ui_font_family": "Open Sans",
  "ui_font_features": { "calt": false },
  "ui_font_size": 15,
  "ui_font_weight": 400,

  "relative_line_numbers": "enabled",
  "current_line_highlight": "all",
  "rounded_selection": false,
  "cursor_blink": true,
  "hide_mouse": "on_typing_and_action",

  "tab_size": 2,
  "hard_tabs": false,
  "preferred_line_length": 100,
  "wrap_guides": [100],
  "soft_wrap": "none",

  "format_on_save": "on",
  "auto_indent_on_paste": true,
  "autosave": "on_focus_change",

  "minimap": { "show": "never" },
  "colorize_brackets": false,

  "preview_tabs": { "enabled": false },

  "pane_split_direction_vertical": "right",
  "pane_split_direction_horizontal": "down",

  "extend_comment_on_newline": false,

  // =========================
  // Panels & UI
  // =========================
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
  },
  "project_panel": {
    "default_width": 300,
    "drag_and_drop": false,
    "indent_guides": {
      "show": "never",
    },
    "button": false,
    "dock": "left",
    "entry_spacing": "comfortable",
    "auto_fold_dirs": true,
    "show_diagnostics": "all",
    "sort_mode": "directories_first",
    "hide_hidden": false,
    "starts_open": true,
    "hide_root": true,
    "git_status": true,
    "sticky_scroll": false,
    "scrollbar": {
      "show": "never",
    },
  },
  "tab_bar": {
    "show": true,
    "show_tab_bar_buttons": false,
    "show_nav_history_buttons": false,
  },
  "tabs": {
    "git_status": true,
    "file_icons": true,
    "show_diagnostics": "all",
  },
  "git": { "inline_blame": { "enabled": false } },
  "selection_highlight": true,
  "title_bar": {
    "show_branch_name": true,
    "show_project_items": true,
    "show_onboarding_banner": false,
    "show_user_picture": false,
    "show_user_menu": true,
    "show_sign_in": false,
    "show_menus": false,
  },
  "inlay_hints": { "enabled": false }, // enable selectively via lsp
  "gutter": {
    "line_numbers": true,
    "folds": false,
  },
  "git_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
    "indent_guides": {
      "show": "always",
    },
    "button": false,
  },
  "debugger": {
    "button": false,
  },
  "search": {
    "button": false,
  },
  "diagnostics": {
    "button": true,
  },
  "status_bar": {
    "experimental.show": true,
    "cursor_position_button": true,
    "active_language_button": true,
  },
  "when_closing_with_no_tabs": "keep_window_open", // keep window open when closing all tabs

  // =========================
  // Terminal
  // =========================
  "terminal": {
    "dock": "bottom",
    "font_family": "JetBrainsMono Nerd Font Mono",
    "font_size": 15,
    "font_weight": 400, // default
    "copy_on_select": true,
    "default_height": 320, // default
    // "default_width": 640, // default for terminal on right split
    "cursor_shape": "bar",
    "blinking": "on",
    "button": false,
    "working_directory": "current_project_directory",
    "detect_venv": {
      "on": {
        "directories": [".venv"],
        "activate_script": "default",
      },
    },
    "toolbar": { "breadcrumbs": false },
  },

  // =========================
  // Languages (Python, Markdown)
  // =========================
  "languages": {
    "Python": {
      "tab_size": 4,
      "language_servers": ["basedpyright"],
      "formatter": { "language_server": { "name": "ruff" } },
      "code_actions_on_format": {
        "source.organizeImports.ruff": true, // organize imports
        "source.fixAll.ruff": true, // fix all auto-fixable lint violations
      },
    },
    "Markdown": {
      "soft_wrap": "editor_width",
      "format_on_save": "off", // disables forced reformatting of `__init__.py` to `**init**.py`
      "extend_list_on_newline": true,
      "indent_list_on_tab": true,
      "remove_trailing_whitespace_on_save": true,
    },
  },
  "lsp": {
    "basedpyright": {
      "settings": {
        "basedpyright.analysis": {
          "diagnosticMode": "openFilesOnly", // openFilesOnly | workspace
          "autoSearchPaths": true,
          "useLibraryCodeForTypes": true,
          "inlayHints": { "callArgumentNames": true },
        },
      },
    },
    "markdownlint": {
      "settings": {
        "MD004": false, // disable unordered list style warning for "-"
        "MD013": false, // disable line-length warning
        "MD024": false, // allow duplicate headings
        "MD029": false, // allow custom ordered list prefixes
        "MD033": false, // allow inline HTML
        "MD036": false, // allow emphasis as heading
        "MD059": false, // allow non-descriptive link text
        "MD060": false, // allow table misalignment
      },
    },
    "ruff": {
      "initialization_options": {
        "settings": {
          // Ruff server settings go here
          "lineLength": 100,
          "lint": {
            "extendSelect": ["I"],
          },
        },
      },
    },
  },
  "diagnostics_max_severity": "all", // off | error | warning | info | hint | all

  // =========================
  // AI / Copilot
  // =========================
  "agent_ui_font_size": 18,
  "agent_buffer_font_size": 13,
  "agent_servers": {
    "github-copilot-cli": {
      "default_config_options": {
        "allow_all": "off",
        "model": "gpt-5-mini",
      },
      "type": "registry",
    },
    "github-copilot": {
      "type": "registry",
    },
  },
  "agent": {
    "dock": "right",
    "default_width": 640,
    "default_profile": "write",
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-5-mini",
    },
    // if not set, following features fall back to default model
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "gpt-5-mini",
    },
    "commit_message_model": {
      "provider": "copilot_chat",
      "model": "gpt-5-mini",
    },
    "thread_summary_model": {
      "provider": "copilot_chat",
      "model": "gpt-5-mini",
    },
    "model_parameters": [],
  },
  "collaboration_panel": {
    "dock": "left",
    "button": false,
  },
  "edit_predictions": {
    "disabled_globs": [],
    "provider": "copilot",
  },

  // =========================
  // Startup & Telemetry
  // =========================
  "restore_on_startup": "last_session",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
}
